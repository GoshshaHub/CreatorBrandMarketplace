rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ① Allow Firestore-triggered Cloud Functions
    allow read, write: if
      request.auth != null &&
      request.auth.token.sub == "service-341251843257@gcp-sa-firestore.iam.gserviceaccount.com";

    // ② Public reads everywhere except the private CRM namespace.
    // Recovered from production ruleset bf9ef8ba-4e77-4b91-954f-b1644b262157;
    // the top-level collection capture preserves existing non-CRM behavior.
    match /{topLevelCollection}/{document=**} {
      allow read: if topLevelCollection != "crm";
      allow write: if
        topLevelCollection != "crm" &&
        request.auth != null;  // Clients must be logged in
    }

    // CRM is server-only. Firebase Admin SDK access bypasses client rules.
    match /crm/{document=**} {
      allow read, write: if false;
    }

    // ③ Publicly writable collections
    match /Metric/{document=**} {
      allow read, write: if true;
    }

// 🟦 Special rule: allow server/admin Cloud Functions to write master playlists
		match /masters/{doc} {
  		allow read: if true;
 		 allow write: if request.auth == null;  // allow Cloud Functions writes
		}

    match /Feed/{document=**} {
      allow read, write: if true;
    }
    
    match /campaigns/{campaignId} {
  		allow read, write: if request.auth != null;
		}
  }
}



